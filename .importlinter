; Module dependency direction, enforced in required CI.
; PLAN.md section 11 states the allowed direction as "A -> B means A may import B":
;
;     cli          -> packs, engine, emit, manifest, annotate, identifiers
;     packs        -> engine
;     identifiers  -> engine
;     annotate     -> engine
;     emit         -> annotate, engine
;     manifest     -> emit, engine
;
; Cycles are forbidden. `engine` imports only the standard library.
;
; Layers are declared optional with parentheses so that this contract is
; enforceable from WP-00 onward and tightens automatically as each owning
; milestone materializes its module. No empty placeholder package is created
; to satisfy the contract early.

[importlinter]
root_package = mintmark
include_external_packages = True

[importlinter:contract:layers]
name = Module layers follow the declared dependency direction
type = layers
layers =
    (cli)
    (manifest)
    (emit)
    (annotate) : (identifiers) : (packs)
    (engine)

; The forbidden contracts below name modules that do not exist yet. Unlike
; layers, forbidden contracts have no optional syntax, so each one is
; activated by the milestone that creates its source module:
;
;     engine-is-stdlib-only   WP-01  ACTIVE
;     identifiers-narrow      WP-03  ACTIVE
;     annotate-narrow         WP-04  ACTIVE
;     packs-narrow            WP-06  ACTIVE
;     emit-narrow             WP-09  ACTIVE
;     manifest-narrow         WP-10
;
; Uncomment a contract in its owning milestone, never earlier and never later.
; WP-14's gate asserts that every contract below is active.
;
[importlinter:contract:engine-is-stdlib-only]
name = engine imports no other mintmark module
type = forbidden
source_modules =
    mintmark.engine
forbidden_modules =
    mintmark.cli
    mintmark.manifest
    mintmark.emit
    mintmark.annotate
    mintmark.identifiers
    mintmark.packs
    mintmark.lexicons
allow_indirect_imports = False

[importlinter:contract:emit-narrow]
name = emit imports only annotate and engine
type = forbidden
source_modules =
    mintmark.emit
forbidden_modules =
    mintmark.cli
    mintmark.manifest
    mintmark.identifiers
    mintmark.packs
allow_indirect_imports = False

; [importlinter:contract:manifest-narrow]
; name = manifest imports only emit and engine
; type = forbidden
; source_modules =
;     mintmark.manifest
; forbidden_modules =
;     mintmark.cli
;     mintmark.identifiers
;     mintmark.packs
; allow_indirect_imports = False

[importlinter:contract:identifiers-narrow]
name = identifiers imports only engine
type = forbidden
source_modules =
    mintmark.identifiers
forbidden_modules =
    mintmark.cli
    mintmark.manifest
    mintmark.emit
allow_indirect_imports = False

[importlinter:contract:annotate-narrow]
name = annotate imports only engine
type = forbidden
source_modules =
    mintmark.annotate
forbidden_modules =
    mintmark.cli
    mintmark.manifest
    mintmark.emit
    mintmark.identifiers
allow_indirect_imports = False

[importlinter:contract:packs-narrow]
name = packs imports only engine
type = forbidden
source_modules =
    mintmark.packs
forbidden_modules =
    mintmark.cli
    mintmark.manifest
    mintmark.emit
    mintmark.identifiers
    mintmark.annotate
allow_indirect_imports = False
